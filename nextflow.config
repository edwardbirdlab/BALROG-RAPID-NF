/*
 * BALROG-RAPID Nextflow Pipeline Configuration
 *
 * Metagenomic pathogen detection, host profiling, and AMR detection
 */

nextflow.enable.dsl = 2

manifest {
    name            = 'BALROG-RAPID'
    author          = 'Edward Bird'
    homePage        = 'https://github.com/edwardbirdlab/BALROG-RAPID-NF'
    description     = 'Metagenomic pathogen detection, host profiling, and AMR detection (short-read + Oxford Nanopore long-read)'
    mainScript      = 'main.nf'
    nextflowVersion = '>=24.04.0'
    version         = '2.0.0'
}

// Max resource limits (overwrite in profile or CLI)
params.max_memory = '750.GB'
params.max_cpus   = 36
params.max_time   = '24.h'

// --- Input ---
params.sample_sheet = null       // CSV: sample,library,molecule,r1,r2,reads
params.outdir       = './results'
params.project_name = 'BALROG_RAPID_NEXUS'
params.publish_dir_mode = 'default' // Options: 'default', 'copy', 'symlink', 'link'

// --- Databases ---
params.kraken2_db  = null    // Path to unified Kraken2 database
params.sylph_db    = null    // Path to Sylph database (.syldb)
params.diamond_db  = null    // Path to Diamond AMR database (.dmnd)
params.host_sheet  = null    // Optional CSV: host_name,kraken2_db

// --- Sylph-tax Parameters ---
params.sylph_tax_db       = null         // Path to pre-downloaded sylph-tax taxonomy DB directory
params.sylph_tax_taxonomy = 'GTDB_r226'  // Which taxonomy to use (GTDB_r226, GTDB_r220, IMGVR_4.1, etc.)

// --- Kraken2 Parameters ---
params.k2_confidence     = 0.3
params.k2_min_hit_groups = 3

// --- FASTP Trimming Parameters ---
params.fastp_q      = 20    // Minimum quality score
params.fastp_minlen = 100   // Minimum read length after trimming

// --- BBDuk Trimming Parameters (Element Biosciences Aviti) ---
params.run_bbduk              = false    // Off by default — enable with --run_bbduk
params.bbduk_adapters         = "${projectDir}/assets/element_aviti_adapters.fasta"
params.bbduk_ktrim            = 'r'      // Right-side kmer trimming
params.bbduk_hdist            = 1        // Hamming distance tolerance
params.bbduk_additional_args  = ''       // Extra bbduk.sh flags

// --- Spike-in Removal Parameters (T. thermophilus control) ---
params.run_spike_in    = false   // Off by default — enable with --run_spike_in
params.spike_in_bt2    = "${projectDir}/assets/t_thermophilus_bt2"  // Pre-built Bowtie2 index directory

// --- Diamond Parameters ---
params.diamond_evalue      = '1e-10'
params.diamond_max_targets = 500

// --- SPAdes Parameters ---
params.spades_memory = 16   // GB, for micro-assembly of AMR reads

// --- ONT QC Parameters (Filtlong) ---
params.filtlong_min_length   = 1000   // Minimum read length to keep
params.filtlong_keep_percent = 90     // Keep top N% of reads by quality

// --- Flye Assembly Parameters ---
params.flye_read_type = '--nano-hq'   // Use --nano-raw for older chemistry (R9)

// --- Nonpareil Coverage Estimation Parameters ---
params.run_nonpareil = true   // On by default — disable with --run_nonpareil false

// --- Targeted SNP / AA Variant Profiling ---
params.run_snp_profiling      = false   // Off by default — enable with --run_snp_profiling
params.snp_cds_fasta          = null    // CDS nucleotide FASTA of target genes
params.snp_positions_csv      = null    // CSV: gene_name,protein_position,wt_aa,mutant_aas,annotation
params.snp_min_base_quality   = 20     // Minimum per-base quality for codon extraction (Phred)
params.snp_min_mapq           = 30     // Minimum mapping quality for read inclusion
params.snp_min_depth          = 10     // Minimum codon depth to report (below = low confidence warning)

// --- Custom QC Metrics ---
params.custom_qc = false   // Off by default — enable with --custom_qc

// --- Optional Steps ---
params.run_qc             = true   // Run FASTP + FastQC
params.run_taxonomy       = true   // Run Kraken2 + Sylph
params.run_host_profiling = true   // Run Kraken2 against host genome(s)
params.run_amr            = true   // Run AMR subset detection pipeline
params.run_multiqc        = true   // Run MultiQC aggregation report

// --- SLURM ---
params.slurm_account = null   // Required on Ceres: --slurm_account <group>

// --- MultiQC ---
params.multiqc_config = "${projectDir}/configs/multiqc_config.yaml"


// Load base config for resource labels and error handling
includeConfig 'configs/base.config'


// Absolute ceiling for any process's resource request, regardless of label.
// Nextflow automatically clamps requests down to these limits (replaces the
// old nf-core `check_max()` helper function, which the modern strict config
// parser -- Nextflow >=24.04 -- can no longer parse as a top-level def).
process {
    resourceLimits = [
        cpus:   params.max_cpus,
        memory: params.max_memory,
        time:   params.max_time
    ]
}


// -------------------------------------------------------------------
// Container engine profiles
// -------------------------------------------------------------------
// No engine is enabled by default -- pick one explicitly with -profile,
// e.g.: nextflow run main.nf -profile docker ...
profiles {
    docker {
        docker.enabled       = true
        singularity.enabled  = false
        apptainer.enabled    = false
        docker.runOptions    = '-u $(id -u):$(id -g)'
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled          = false
        apptainer.enabled       = false
    }
    apptainer {
        apptainer.enabled    = true
        apptainer.autoMounts = true
        docker.enabled       = false
        singularity.enabled  = false
    }
}
