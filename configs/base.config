/*
 * BALROG-RAPID Base Configuration
 *
 * Resource labels, error handling, and publishDir settings
 */

process {

    // Defaults (process.resourceLimits in nextflow.config clamps these to
    // params.max_cpus/max_memory/max_time regardless of label)
    cpus   = { 1    * task.attempt }
    memory = { 6.GB * task.attempt }
    time   = { 4.h  * task.attempt }

    // Retry on common transient failures (signals 130-145, I/O error 104)
    errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'finish' }
    maxRetries    = 3
    maxErrors     = '-1'

    // --- Resource Labels ---

    withLabel: ultralow {
        cpus   = 1
        memory = { 5.GB * task.attempt }
        time   = { 2.h  * task.attempt }
    }

    withLabel: lowmem {
        cpus   = 8
        memory = { 16.GB * task.attempt }
        time   = { 4.h   * task.attempt }
    }

    withLabel: kraken2 {
        cpus   = 16
        memory = { 456.GB * task.attempt }
        time   = { 24.h   * task.attempt }
    }

    withLabel: sylph_profile {
        cpus   = 16
        memory = { 150.GB * task.attempt }
        time   = { 1.h    * task.attempt }
    }

    withLabel: diamond {
        cpus   = 8
        memory = { 16.GB * task.attempt }
        time   = { 4.h   * task.attempt }
    }

    withLabel: spades_subset {
        cpus   = 16
        memory = { 32.GB * task.attempt }
        time   = { 6.h   * task.attempt }
    }

    withLabel: amrfinder {
        cpus   = 8
        memory = { 16.GB * task.attempt }
        time   = { 2.h   * task.attempt }
    }

    withLabel: porechop {
        cpus   = 8
        memory = { 100.GB * task.attempt }
        time   = { 4.h    * task.attempt }
    }

    withLabel: flye {
        cpus   = 16
        memory = { 64.GB * task.attempt }
        time   = { 12.h  * task.attempt }
    }

    withLabel: nanoplot {
        cpus   = 4
        memory = { 8.GB * task.attempt }
        time   = { 2.h  * task.attempt }
    }
}


/*
 * PublishDir configuration
 *
 * Routes outputs to Phase 2 compatible directory structure:
 *   taxonomy/kraken2/  - Kraken2 reports (unified DB)
 *   taxonomy/sylph/    - Sylph profiles
 *   host/kraken2/      - Kraken2 reports (host DBs)
 *   amr/diamond/       - Diamond BLASTX results
 *   amr/extracted_reads/ - seqtk subset reads
 *   amr/assemblies/    - SPAdes micro-assembly contigs
 *   amr/amrfinder/     - AMRFinder results
 *   qc/                - QC reports and trimming results
 */

process {

    // Default publishDir (fallback for unlisted processes)
    publishDir = [
        path:    { "${params.outdir}/other" },
        mode:    params.publish_dir_mode == 'default' ? null : params.publish_dir_mode,
        enabled: false
    ]

    // --- QC outputs ---
    withName: 'FASTQC_RAW' {
        publishDir = [
            path: { "${params.outdir}/qc/fastqc_raw" },
            mode: params.publish_dir_mode == 'default' ? null : params.publish_dir_mode
        ]
    }
    withName: 'FASTP' {
        publishDir = [
            path: { "${params.outdir}/qc/fastp" },
            mode: params.publish_dir_mode == 'default' ? null : params.publish_dir_mode
        ]
    }
    withName: 'BBDUK' {
        publishDir = [
            path: { "${params.outdir}/qc/bbduk" },
            mode: params.publish_dir_mode == 'default' ? null : params.publish_dir_mode
        ]
    }
    withName: 'SPIKE_IN_REMOVAL' {
        publishDir = [
            [
                path: { "${params.outdir}/spike_in" },
                mode: params.publish_dir_mode == 'default' ? null : params.publish_dir_mode,
                pattern: "*_bowtie2_spike.log"
            ],
            [
                path: { "${params.outdir}/spike_in" },
                mode: params.publish_dir_mode == 'default' ? null : params.publish_dir_mode,
                pattern: "*_spike_stats.tsv"
            ]
        ]
    }
    withName: 'FASTQC_TRIMMED' {
        publishDir = [
            path: { "${params.outdir}/qc/fastqc_trimmed" },
            mode: params.publish_dir_mode == 'default' ? null : params.publish_dir_mode
        ]
    }

    // --- Taxonomy outputs (Phase 2 compatible) ---
    withName: 'KRAKEN2' {
        publishDir = [
            path: { "${params.outdir}/taxonomy/kraken2" },
            mode: params.publish_dir_mode == 'default' ? null : params.publish_dir_mode
        ]
    }
    withName: 'SYLPH' {
        publishDir = [
            path: { "${params.outdir}/taxonomy/sylph" },
            mode: params.publish_dir_mode == 'default' ? null : params.publish_dir_mode
        ]
    }
    withName: 'SYLPH_TAX' {
        publishDir = [
            path: { "${params.outdir}/taxonomy/sylph_tax" },
            mode: params.publish_dir_mode == 'default' ? null : params.publish_dir_mode
        ]
    }

    // --- Host profiling outputs ---
    withName: 'KRAKEN2_HOST' {
        publishDir = [
            path: { "${params.outdir}/host/kraken2" },
            mode: params.publish_dir_mode == 'default' ? null : params.publish_dir_mode
        ]
    }

    // --- AMR outputs (Phase 2 compatible) ---
    withName: 'DIAMOND_BLASTX' {
        publishDir = [
            path: { "${params.outdir}/amr/diamond" },
            mode: params.publish_dir_mode == 'default' ? null : params.publish_dir_mode
        ]
    }
    withName: 'SEQTK_SUBSEQ' {
        publishDir = [
            path: { "${params.outdir}/amr/extracted_reads" },
            mode: params.publish_dir_mode == 'default' ? null : params.publish_dir_mode
        ]
    }
    withName: 'SPADES' {
        publishDir = [
            path: { "${params.outdir}/amr/assemblies" },
            mode: params.publish_dir_mode == 'default' ? null : params.publish_dir_mode
        ]
    }
    withName: 'AMRFINDER' {
        publishDir = [
            path: { "${params.outdir}/amr/amrfinder" },
            mode: params.publish_dir_mode == 'default' ? null : params.publish_dir_mode
        ]
    }

    // --- Nonpareil outputs ---
    withName: 'EXTRACT_BACTERIAL_READS' {
        publishDir = [
            [
                path: { "${params.outdir}/nonpareil/bacterial_extraction" },
                mode: params.publish_dir_mode == 'default' ? null : params.publish_dir_mode,
                pattern: "*_bacterial_extraction_stats.tsv"
            ]
        ]
    }
    withName: 'NONPAREIL' {
        publishDir = [
            [
                path: { "${params.outdir}/nonpareil" },
                mode: params.publish_dir_mode == 'default' ? null : params.publish_dir_mode,
                pattern: "*.npo"
            ],
            [
                path: { "${params.outdir}/nonpareil" },
                mode: params.publish_dir_mode == 'default' ? null : params.publish_dir_mode,
                pattern: "*.npa"
            ]
        ]
    }

    // --- ONT QC outputs ---
    withName: 'FASTQC_RAW_SE' {
        publishDir = [
            path: { "${params.outdir}/qc/fastqc_raw" },
            mode: params.publish_dir_mode == 'default' ? null : params.publish_dir_mode
        ]
    }
    withName: 'FASTQC_TRIMMED_SE' {
        publishDir = [
            path: { "${params.outdir}/qc/fastqc_trimmed" },
            mode: params.publish_dir_mode == 'default' ? null : params.publish_dir_mode
        ]
    }
    withName: 'PORECHOP_ABI' {
        publishDir = [
            path: { "${params.outdir}/qc/porechop_abi" },
            mode: params.publish_dir_mode == 'default' ? null : params.publish_dir_mode
        ]
    }
    withName: 'FILTLONG' {
        publishDir = [
            path: { "${params.outdir}/qc/filtlong" },
            mode: params.publish_dir_mode == 'default' ? null : params.publish_dir_mode
        ]
    }
    withName: 'NANOPLOT' {
        publishDir = [
            path: { "${params.outdir}/qc/nanoplot" },
            mode: params.publish_dir_mode == 'default' ? null : params.publish_dir_mode
        ]
    }

    // --- ONT taxonomy outputs (Phase 2 compatible) ---
    withName: 'KRAKEN2_SE' {
        publishDir = [
            path: { "${params.outdir}/taxonomy/kraken2" },
            mode: params.publish_dir_mode == 'default' ? null : params.publish_dir_mode
        ]
    }
    withName: 'SYLPH_SE' {
        publishDir = [
            path: { "${params.outdir}/taxonomy/sylph" },
            mode: params.publish_dir_mode == 'default' ? null : params.publish_dir_mode
        ]
    }

    // --- ONT host profiling outputs ---
    withName: 'KRAKEN2_HOST_SE' {
        publishDir = [
            path: { "${params.outdir}/host/kraken2" },
            mode: params.publish_dir_mode == 'default' ? null : params.publish_dir_mode
        ]
    }

    // --- ONT AMR outputs (Phase 2 compatible) ---
    withName: 'DIAMOND_BLASTX_SE' {
        publishDir = [
            path: { "${params.outdir}/amr/diamond" },
            mode: params.publish_dir_mode == 'default' ? null : params.publish_dir_mode
        ]
    }
    withName: 'SEQTK_SUBSEQ_SE' {
        publishDir = [
            path: { "${params.outdir}/amr/extracted_reads" },
            mode: params.publish_dir_mode == 'default' ? null : params.publish_dir_mode
        ]
    }
    withName: 'FLYE' {
        publishDir = [
            path: { "${params.outdir}/amr/assemblies" },
            mode: params.publish_dir_mode == 'default' ? null : params.publish_dir_mode
        ]
    }

    // --- ONT Nonpareil outputs ---
    withName: 'EXTRACT_BACTERIAL_READS_SE' {
        publishDir = [
            [
                path: { "${params.outdir}/nonpareil/bacterial_extraction" },
                mode: params.publish_dir_mode == 'default' ? null : params.publish_dir_mode,
                pattern: "*_bacterial_extraction_stats.tsv"
            ]
        ]
    }
    withName: 'NONPAREIL_SE' {
        publishDir = [
            [
                path: { "${params.outdir}/nonpareil" },
                mode: params.publish_dir_mode == 'default' ? null : params.publish_dir_mode,
                pattern: "*.npo"
            ],
            [
                path: { "${params.outdir}/nonpareil" },
                mode: params.publish_dir_mode == 'default' ? null : params.publish_dir_mode,
                pattern: "*.npa"
            ]
        ]
    }

    // --- SNP Profiling outputs ---
    withName: 'BWA_INDEX_SNP' {
        publishDir = [
            path:    { "${params.outdir}/other" },
            mode:    params.publish_dir_mode == 'default' ? null : params.publish_dir_mode,
            enabled: false
        ]
    }
    withName: 'BWA_MEM_SNP' {
        publishDir = [
            path: { "${params.outdir}/snp_profiling/alignments" },
            mode: params.publish_dir_mode == 'default' ? null : params.publish_dir_mode
        ]
    }
    withName: 'MINIMAP2_SNP' {
        publishDir = [
            path: { "${params.outdir}/snp_profiling/alignments" },
            mode: params.publish_dir_mode == 'default' ? null : params.publish_dir_mode
        ]
    }
    withName: 'EXTRACT_CODON_FREQS|EXTRACT_CODON_FREQS_SE' {
        publishDir = [
            path: { "${params.outdir}/snp_profiling/codon_freqs" },
            mode: params.publish_dir_mode == 'default' ? null : params.publish_dir_mode
        ]
    }
    withName: 'SUMMARIZE_SNP_PROFILING|SUMMARIZE_SNP_PROFILING_ONT' {
        publishDir = [
            path:    { "${params.outdir}/other" },
            mode:    params.publish_dir_mode == 'default' ? null : params.publish_dir_mode,
            enabled: false
        ]
    }

    // --- AMR summary for MultiQC (not published separately, consumed by MultiQC) ---
    withName: 'SUMMARIZE_AMRFINDER|SUMMARIZE_AMRFINDER_ONT' {
        publishDir = [
            path:    { "${params.outdir}/other" },
            mode:    params.publish_dir_mode == 'default' ? null : params.publish_dir_mode,
            enabled: false
        ]
    }

    // --- Pipeline info ---
    withName: 'COLLECT_VERSIONS' {
        publishDir = [
            path: { "${params.outdir}/pipeline_info" },
            mode: params.publish_dir_mode == 'default' ? null : params.publish_dir_mode
        ]
    }

    // --- MultiQC report ---
    withName: 'MULTIQC' {
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode == 'default' ? null : params.publish_dir_mode
        ]
    }
}
