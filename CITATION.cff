cff-version: 1.2.0
message: "If you use this pipeline, please cite it as below."
title: "BALROG-RAPID"
type: software
authors:
  - family-names: Bird
    given-names: Edward
license: MIT
version: 2.0.0
date-released: 2026-07-28
repository-code: "https://github.com/edwardbirdlab/BALROG-RAPID-NF"
abstract: >-
  A Nextflow DSL2 pipeline for metagenomic pathogen detection, host profiling, antimicrobial
  resistance (AMR) gene detection, and targeted SNP/amino-acid variant profiling, supporting both
  Illumina/Element short reads and Oxford Nanopore long reads.

# Citations for every third-party tool the pipeline wraps.
references:
